{
  "all": true,
  "src": ["packages"],
  "include": ["packages/*/src/**", "packages/*/dist/**"],
  "exclude": ["**/test/**", "**/fixtures/**", "**/*.d.ts", "**/node_modules/**"],
  "excludeAfterRemap": true,
  "reporter": ["text-summary", "json-summary", "text"],
  "reportsDir": "coverage",
  "tempDirectory": "coverage/tmp"
}

{
  "name": "tzap-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b packages/tzap",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm build && pnpm check:boundaries && pnpm test",
    "bundle": "node scripts/bundle.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
